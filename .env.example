# Copy to .env (or set real environment variables in production).
# When this folder sits inside the Finpro repo, the parent Finpro .env is read too.

# development | production (NODE_ENV is also accepted)
AI_ENV=development
# AI_SERVICE_HOST=127.0.0.1
# AI_SERVICE_PORT=8090
# Shared secret with the Finpro API (same value there). Required, 32+ chars, in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
# AI_SERVICE_TOKEN=

# --- Fast tier (most questions). Default: ollama in development, hosted in production ---
# AI_FAST_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b
# Hosted open-source model, any OpenAI-compatible API. Examples:
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepInfra   https://api.deepinfra.com/v1/openai
# AI_HOSTED_NAME=groq
# AI_HOSTED_BASE_URL=
# AI_HOSTED_API_KEY=
# AI_HOSTED_MODEL=

# --- Top tier (complex questions / "Deep analysis"): anthropic | openai | none ---
# AI_TOP_PROVIDER=anthropic
# AI_TOP_API_KEY=
# AI_TOP_MODEL=claude-opus-5-5
# AI_TOP_BASE_URL=https://api.openai.com/v1

# --- Routing & cost control ---
# AI_ROUTING_MODE=auto              # auto | fast | top
# AI_COMPLEX_THRESHOLD=4            # lower = more questions go to the top model
# AI_TOP_DAILY_LIMIT_PER_ORG=200    # 0 = unlimited
# AI_REDACT_PII=true                # mask PAN/Aadhaar/mobile/e-mail before calling hosted models
# AI_CACHE_TTL_SECONDS=600

# --- Generation ---
# AI_TEMPERATURE=0.2
# AI_MAX_OUTPUT_TOKENS=1500
# AI_TOP_MAX_OUTPUT_TOKENS=3000
# AI_TIMEOUT_SECONDS=90
# AI_LOG_LEVEL=INFO
